# ===========================================================================
# CapEx AI Agent - .env.example
# Copy to `.env` (or export in your shell) and fill in real values.
# Credentials are NEVER hard-coded in the codebase.
# ===========================================================================

# --- SMTP for report e-mail delivery (Final Report page) --------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password_here

# --- Data source tuning -----------------------------------------------------
# (optional) Override the data cache lifetime used by the macro engine, hours.
MACRO_CACHE_MAX_AGE_HOURS=12

# --- Streamlit options ------------------------------------------------------
# STREAMLIT_SERVER_HEADLESS=true
# STREAMLIT_BROWSER_GATHER_USAGE_STATS=false